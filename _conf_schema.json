{
  "enabled": {
    "description": "启用语音功能",
    "type": "bool",
    "default": true
  },
  "provider": {
    "description": "首选语音后端",
    "type": "string",
    "options": ["breezeblue", "cosyvoice"],
    "labels": ["BreezeBlue（推荐，情绪更自然）", "CosyVoice"],
    "default": "breezeblue"
  },
  "fallback_to_cosyvoice": {
    "description": "BreezeBlue 额度不足/失败时自动回退 CosyVoice",
    "type": "bool",
    "default": true
  },
  "breezeblue_enabled": {
    "description": "启用 BreezeBlue",
    "type": "bool",
    "default": true
  },
  "breezeblue_api_key": {
    "description": "BreezeBlue API Key",
    "type": "string",
    "default": ""
  },
  "breezeblue_voice_id": {
    "description": "BreezeBlue 爱弥斯音色 ID",
    "type": "string",
    "default": "voc_s7q9c9v958re"
  },
  "breezeblue_model": {
    "description": "BreezeBlue 模型 ID",
    "type": "string",
    "default": "breeze-tts-2"
  },
  "breezeblue_language": {
    "description": "语言代码",
    "type": "string",
    "default": "zh"
  },
  "breezeblue_instruction": {
    "description": "BreezeBlue 表演指令（情绪/语气）",
    "type": "text",
    "default": "用爱弥斯那种温柔、自然、像在 QQ 里随口聊天的语气说，不要客服腔。"
  },
  "breezeblue_guidance_scale": {
    "description": "BreezeBlue 指令遵循强度（1.0–10.0）",
    "type": "float",
    "default": 4.0
  },
  "breezeblue_url": {
    "description": "BreezeBlue API 地址",
    "type": "string",
    "default": "https://api.breeze.blue"
  },
  "api_key": {
    "description": "千问 AI 平台 API Key",
    "type": "string",
    "default": "",
    "hint": "填写后重启本插件生效"
  },
  "model": {
    "description": "语音模型",
    "type": "string",
    "default": "cosyvoice-v3.5-flash"
  },
  "voice": {
    "description": "音色 ID（复刻音色或系统音色）",
    "type": "string",
    "default": "cosyvoice-v3.5-flash-aemeath-59638a19c09243cabf1144ce1be23d28"
  },
  "ws_url": {
    "description": "CosyVoice WebSocket 地址",
    "type": "string",
    "default": "wss://maas.qianwenaiapi.com/api-ws/v1/inference"
  },
  "format": {
    "description": "音频格式（AstrBot Record 只稳定支持 wav）",
    "type": "string",
    "default": "wav"
  },
  "sample_rate": {
    "description": "采样率",
    "type": "int",
    "default": 22050
  },
  "instruction": {
    "description": "情感/语气指令（cosyvoice-v3.5-plus / v3.5-flash 支持；留空不发送）",
    "type": "string",
    "default": "用爱弥斯那种温柔、俏皮、自然的语气说，像在 QQ 里随口聊天，不要客服腔。"
  },
  "prefixes": {
    "description": "语音触发前缀（单字前缀需带空格/冒号等分隔符）",
    "type": "list",
    "default": ["语音", "说", "念", "读", "朗读", "用语音说", "发语音", "语音回复", "读一下", "念一下", "念一遍", "朗读一下", "用声音"]
  },
  "probability": {
    "description": "普通回复改为语音的概率（0~1，0 关闭）",
    "type": "float",
    "default": 0.25
  },
  "max_chars": {
    "description": "概率语音最大字数，超长回退文字",
    "type": "int",
    "default": 120
  },
  "cooldown": {
    "description": "同会话语音冷却（秒）",
    "type": "int",
    "default": 10
  },
  "timeout": {
    "description": "合成超时（秒）",
    "type": "int",
    "default": 60
  }
}
